{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@doudoumonde/shared": ["../packages/shared/src/index.ts"],
      "@doudoumonde/shared/schemas": ["../packages/shared/src/schemas/index.ts"],
      "@doudoumonde/shared/generated": ["../packages/shared/src/generated/index.ts"],
      "@doudoumonde/shared/dtos": ["../packages/shared/src/dtos/index.ts"],
      "@doudoumonde/shared/schemas/gender": ["../packages/shared/src/schemas/types/gender.enum.ts"],
      "@doudoumonde/shared/schemas/profile": ["../packages/shared/src/schemas/types/profile.enum.ts"],
      "@doudoumonde/shared/schemas/genre": ["../packages/shared/src/schemas/types/genre.enum.ts"],
      "@doudoumonde/shared/schemas/sido": ["../packages/shared/src/schemas/types/sido.enum.ts"],
      "@doudoumonde/shared/schemas/role": ["../packages/shared/src/schemas/types/role.enum.ts"],
      "@doudoumonde/shared/schemas/trait": ["../packages/shared/src/schemas/types/trait.enum.ts"]
    }
  },
  "include": ["src", "svg.d.ts"]
}
