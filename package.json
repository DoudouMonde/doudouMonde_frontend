{
  "name": "doudoumonde-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "backend",
    "mobile"
  ],
  "scripts": {
    "dev:frontend": "yarn workspace doudoumonde-frontend dev",
    "dev:backend": "yarn workspace doudouMonde_backend dev",
    "dev:mobile": "yarn workspace doudoumonde_frontend start",
    "build:frontend": "yarn workspace doudoumonde-frontend build",
    "build:backend": "yarn workspace doudouMonde_backend build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "swagger:generate": "yarn workspace doudouMonde_backend swagger:generate",
    "openapi:generate": "yarn swagger:generate && openapi-ts",
    "zod:generate": "ts-node scripts/generate-zod-schemas.ts",
    "api:generate": "yarn swagger:generate && openapi-ts && yarn zod:generate"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.60.0",
    "openapi-typescript-zod": "^4.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  }
}
